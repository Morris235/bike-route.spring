type Route {
    id: ID!
    name: String!
    rate: Int
    finish_time: String
    owner_id: String
    created: String
    deleted: Boolean
}

input RouteInput {
    id: ID!
    name: String!
    rate: Int
    finish_time: String
    owner_id: String
    created: String
    deleted: Boolean
}

type Mutation {
    createRoute(id: ID!, name: String!, rate: Int, finish_time: String, owner_id: String): Route!
    updateRoute(id: ID!, name: String!, rate: Int, finish_time: String, owner_id: String): Route
    deleteRouteById(id: ID!): Boolean
}